<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/scrim"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
    <TextView android:id="@+id/greeting" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:paddingStart="4dp"
        android:shadowColor="#99000000" android:shadowDy="1" android:shadowRadius="4"
        android:textColor="#FBBF24" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/clock" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:fontFamily="sans-serif-thin"
        android:includeFontPadding="false" android:paddingStart="2dp"
        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="6"
        android:textColor="#FFFFFF" android:textSize="72sp" />
    <TextView android:id="@+id/date" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:paddingStart="4dp"
        android:shadowColor="#99000000" android:shadowDy="1" android:shadowRadius="4"
        android:textColor="#E9E4FF" android:textSize="16sp" />
    <EditText android:id="@+id/search" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_marginTop="20dp"
        android:background="@drawable/search_bg" android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_search" android:hint="@string/search_hint"
        android:imeOptions="actionSearch" android:importantForAutofill="no"
        android:inputType="text" android:maxLines="1" android:paddingEnd="18dp"
        android:paddingStart="18dp" android:textColor="#FFFFFF"
        android:textColorHint="#C9C0E8" android:textSize="16sp" />
    <GridView android:id="@+id/grid" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_marginTop="12dp"
        android:layout_weight="1" android:clipToPadding="false"
        android:columnWidth="80dp" android:horizontalSpacing="4dp"
        android:listSelector="@android:color/transparent" android:numColumns="auto_fit"
        android:overScrollMode="never" android:paddingBottom="12dp"
        android:paddingTop="8dp" android:scrollbars="none"
        android:stretchMode="columnWidth" android:verticalSpacing="14dp" />
</LinearLayout>